# The FastAPI app's recipes, a just module of the root justfile: run them as
# `just backend <recipe>` from anywhere in the repository. Each runs in this
# directory, so `uv run` reads backend/pyproject.toml's ruff, mypy, pytest, and
# coverage settings. CI's `Lint & Type Check` and `Coverage` jobs repeat the
# `lint` and `test` lines verbatim in a `working-directory: backend` step
# (tests/harness/test_just_recipes.py holds them equal).

# Lint and type-check the backend (ruff, ruff format --check, mypy strict)
lint:
    uv run --locked ruff check .
    uv run --locked ruff format --check .
    uv run --locked mypy

# Format the backend (lint fixes first so the formatter has the last word)
fmt:
    uv run --locked ruff check --fix .
    uv run --locked ruff format .

# Run the backend tests in parallel with branch coverage (80% floor)
test:
    uv run --locked pytest -n auto --cov --cov-report=term-missing:skip-covered --cov-fail-under=80

# Run the shared contract and migrations on a disposable PostgreSQL database, serially
test-postgres:
    INTENT_TO_ENGLISH_TEST_POSTGRES_URL="${INTENT_TO_ENGLISH_TEST_POSTGRES_URL:-postgresql+asyncpg://postgres:postgres@127.0.0.1:5432/intent_to_english_test}" uv run --locked --extra postgres pytest -m postgres tests

# Resolve only for a database recipe, once at its entry. A dependent migration
# receives that same URL; lint/test never read the developer's dotenv file.
# Settings applies environment > backend/.env; a blank URL uses the dev default.
database_url_command := '''
    uv run --locked python -c 'from intent_to_english.settings import Settings; print(Settings().database_url or "sqlite+aiosqlite:///./var/dev.db")'
'''

# Migrate the database to the newest revision (default: backend/var/dev.db).
# A SQLite file's parent directory is created first; SQLite will not create it.
db-upgrade url=(shell(database_url_command)):
    url={{ quote(url) }}; case "$url" in sqlite+aiosqlite:///*) path="${url#sqlite+aiosqlite:///}"; mkdir -p "$(dirname "${path%%\?*}")" ;; esac
    url={{ quote(url) }}; set --; case "$url" in postgresql+asyncpg:*) set -- --extra postgres ;; esac; INTENT_TO_ENGLISH_DATABASE_URL="$url" uv run --locked "$@" alembic upgrade head

# Summarize recorded model calls without writing or billing; optionally --session UUID or --since WHEN
[positional-arguments]
call-log *ARGS:
    #!/usr/bin/env bash
    set -euo pipefail
    url={{ quote(shell(database_url_command)) }}
    extra=()
    case "$url" in postgresql+asyncpg:*) extra=(--extra postgres) ;; esac
    INTENT_TO_ENGLISH_DATABASE_URL="$url" uv run --locked "${extra[@]}" python -m intent_to_english.call_log "$@"

# Autogenerate a revision from the change to adapters/sql/tables.py, against the migrated database
db-revision MESSAGE url=(shell(database_url_command)): (db-upgrade url)
    url={{ quote(url) }}; set --; case "$url" in postgresql+asyncpg:*) set -- --extra postgres ;; esac; INTENT_TO_ENGLISH_DATABASE_URL="$url" uv run --locked "$@" alembic revision --autogenerate -m {{ quote(MESSAGE) }}

# INTENT_TO_ENGLISH_API_PORT is a process variable that this recipe and frontend/vite.config.ts
# read, never a Settings field. Never ends on its own; an agent runs its own server
# on a free port instead, or its own `just dev` pair (running-the-app).
# Human-run: migrate the database, then serve the API on http://127.0.0.1:${INTENT_TO_ENGLISH_API_PORT:-8000}, reloading on source changes
dev url=(shell(database_url_command)): (db-upgrade url)
    url={{ quote(url) }}; set --; case "$url" in postgresql+asyncpg:*) set -- --extra postgres ;; esac; INTENT_TO_ENGLISH_DATABASE_URL="$url" uv run --locked "$@" uvicorn intent_to_english.api.app:create_app --factory --reload --no-access-log --host 127.0.0.1 --port "${INTENT_TO_ENGLISH_API_PORT:-8000}"

# Human-run: run billed model evaluation and write new reports; refuses in fixed mode
eval *ARGS:
    #!/usr/bin/env bash
    set -euo pipefail
    revision=$(git rev-parse HEAD)
    dirty=false
    if [ -n "$(git status --porcelain)" ]; then dirty=true; fi
    uv run --locked python -m intent_to_english.evaluation --commit "$revision" --dirty "$dirty" "$@"
