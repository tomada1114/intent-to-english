# Optional backend/.env settings. Blank values keep the defaults.
# The process environment takes precedence over this file.

# Default: unset; direct app runs use memory, dev recipes use var/dev.db.
# Set an async SQLAlchemy URL to persist to a migrated SQLite/PostgreSQL database.
INTENT_TO_ENGLISH_DATABASE_URL=

# Default: empty (CORS disabled). Set comma-separated exact HTTP(S) origins.
INTENT_TO_ENGLISH_CORS_ORIGINS=

# Defaults: INFO and text. Levels are case-insensitive; formats are text or json.
INTENT_TO_ENGLISH_LOG_LEVEL=
INTENT_TO_ENGLISH_LOG_FORMAT=
